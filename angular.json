{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "packages",
  "projects": {
    "docs": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/docs",
      "sourceRoot": "apps/docs/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/docs",
            "browser": "apps/docs/src/main.ts",
            "tsConfig": "apps/docs/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/docs/public"
              }
            ],
            "styles": [
              "apps/docs/src/styles.css",
              {
                "input": "apps/docs/src/blocks.css",
                "bundleName": "blocks",
                "inject": false
              },
              {
                "input": "apps/docs/src/components.css",
                "bundleName": "components",
                "inject": false
              }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "525kB",
                  "maximumError": "555kB"
                },
                {
                  "type": "bundle",
                  "name": "main",
                  "maximumWarning": "140kB",
                  "maximumError": "145kB"
                },
                {
                  "type": "bundle",
                  "name": "styles",
                  "maximumWarning": "180kB",
                  "maximumError": "195kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/docs/src/app/dev/dev.routes.ts",
                  "with": "apps/docs/src/app/dev/dev.routes.prod.ts"
                }
              ],
              "styles": [
                "apps/docs/src/styles.prod.css",
                {
                  "input": "apps/docs/src/blocks.css",
                  "bundleName": "blocks",
                  "inject": false
                },
                {
                  "input": "apps/docs/src/components.css",
                  "bundleName": "components",
                  "inject": false
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/docs/tsconfig.spec.json"
          }
        }
      }
    },
    "ui-core": {
      "projectType": "library",
      "root": "packages/ui-core",
      "sourceRoot": "packages/ui-core/src",
      "prefix": "mimi",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "docs:build:development",
            "tsConfig": "packages/ui-core/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
