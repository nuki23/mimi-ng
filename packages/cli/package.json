{
  "name": "@mimi-ng/cli",
  "version": "0.1.1",
  "description": "Angular + Tailwind CSS 4 UI components that a CLI copies into your project, so you own the code. Schematics for ng add and ng generate.",
  "keywords": [
    "angular",
    "angular-components",
    "tailwind",
    "tailwindcss",
    "tailwindcss-v4",
    "ui",
    "ui-components",
    "component-library",
    "design-system",
    "schematics",
    "ng-add",
    "shadcn",
    "mimi"
  ],
  "homepage": "https://ng.mimiworks.dev",
  "bugs": {
    "url": "https://github.com/nuki23/mimi-ng/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuki23/mimi-ng.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Ariel O (https://github.com/nuki23)",
  "type": "commonjs",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./dist/collection.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "dependencies": {
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@schematics/angular": "^22.0.0"
  }
}
