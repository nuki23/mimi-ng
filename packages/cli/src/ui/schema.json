{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MimiUi",
  "title": "Mimi ui",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Componentes que se agregan (varios a la vez: button input form-field).",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": {
        "message": "¿Qué componentes quieres agregar?",
        "type": "list",
        "multiselect": true,
        "items": [
          {
            "value": "avatar",
            "label": "avatar"
          },
          {
            "value": "badge",
            "label": "badge"
          },
          {
            "value": "button",
            "label": "button"
          },
          {
            "value": "calendar",
            "label": "calendar"
          },
          {
            "value": "card",
            "label": "card"
          },
          {
            "value": "checkbox",
            "label": "checkbox"
          },
          {
            "value": "combobox",
            "label": "combobox"
          },
          {
            "value": "confirm",
            "label": "confirm"
          },
          {
            "value": "context-menu",
            "label": "context-menu"
          },
          {
            "value": "date-picker",
            "label": "date-picker"
          },
          {
            "value": "dialog",
            "label": "dialog"
          },
          {
            "value": "dropdown-menu",
            "label": "dropdown-menu"
          },
          {
            "value": "form-field",
            "label": "form-field"
          },
          {
            "value": "input",
            "label": "input"
          },
          {
            "value": "input-mask",
            "label": "input-mask"
          },
          {
            "value": "input-otp",
            "label": "input-otp"
          },
          {
            "value": "number-input",
            "label": "number-input"
          },
          {
            "value": "pagination",
            "label": "pagination"
          },
          {
            "value": "password",
            "label": "password"
          },
          {
            "value": "popover",
            "label": "popover"
          },
          {
            "value": "progress",
            "label": "progress"
          },
          {
            "value": "select",
            "label": "select"
          },
          {
            "value": "separator",
            "label": "separator"
          },
          {
            "value": "skeleton",
            "label": "skeleton"
          },
          {
            "value": "slider",
            "label": "slider"
          },
          {
            "value": "switch",
            "label": "switch"
          },
          {
            "value": "tabs",
            "label": "tabs"
          },
          {
            "value": "tags-input",
            "label": "tags-input"
          },
          {
            "value": "textarea",
            "label": "textarea"
          },
          {
            "value": "toast",
            "label": "toast"
          },
          {
            "value": "toggle-group",
            "label": "toggle-group"
          },
          {
            "value": "toolbar",
            "label": "toolbar"
          },
          {
            "value": "tooltip",
            "label": "tooltip"
          }
        ]
      }
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Reemplaza los archivos que ya existan con otro contenido."
    }
  }
}
