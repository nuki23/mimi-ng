{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MimiUi",
  "title": "Mimi ui",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Componentes o Blocks que se agregan (varios a la vez: button input form-field, o un Block: login-01).",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": {
        "message": "¿Qué componentes o Blocks quieres agregar?",
        "type": "list",
        "multiselect": true,
        "items": [
          {
            "value": "avatar",
            "label": "avatar"
          },
          {
            "value": "badge",
            "label": "badge"
          },
          {
            "value": "button",
            "label": "button"
          },
          {
            "value": "calendar",
            "label": "calendar"
          },
          {
            "value": "card",
            "label": "card"
          },
          {
            "value": "checkbox",
            "label": "checkbox"
          },
          {
            "value": "color-picker",
            "label": "color-picker"
          },
          {
            "value": "combobox",
            "label": "combobox"
          },
          {
            "value": "confirm",
            "label": "confirm"
          },
          {
            "value": "context-menu",
            "label": "context-menu"
          },
          {
            "value": "date-picker",
            "label": "date-picker"
          },
          {
            "value": "date-range",
            "label": "date-range"
          },
          {
            "value": "dialog",
            "label": "dialog"
          },
          {
            "value": "dropdown-menu",
            "label": "dropdown-menu"
          },
          {
            "value": "file-upload",
            "label": "file-upload"
          },
          {
            "value": "form-field",
            "label": "form-field"
          },
          {
            "value": "input",
            "label": "input"
          },
          {
            "value": "input-mask",
            "label": "input-mask"
          },
          {
            "value": "input-otp",
            "label": "input-otp"
          },
          {
            "value": "number-input",
            "label": "number-input"
          },
          {
            "value": "pagination",
            "label": "pagination"
          },
          {
            "value": "password",
            "label": "password"
          },
          {
            "value": "popover",
            "label": "popover"
          },
          {
            "value": "progress",
            "label": "progress"
          },
          {
            "value": "select",
            "label": "select"
          },
          {
            "value": "separator",
            "label": "separator"
          },
          {
            "value": "skeleton",
            "label": "skeleton"
          },
          {
            "value": "slider",
            "label": "slider"
          },
          {
            "value": "switch",
            "label": "switch"
          },
          {
            "value": "tabs",
            "label": "tabs"
          },
          {
            "value": "tags-input",
            "label": "tags-input"
          },
          {
            "value": "textarea",
            "label": "textarea"
          },
          {
            "value": "toast",
            "label": "toast"
          },
          {
            "value": "toggle-group",
            "label": "toggle-group"
          },
          {
            "value": "toolbar",
            "label": "toolbar"
          },
          {
            "value": "tooltip",
            "label": "tooltip"
          },
          {
            "value": "tree",
            "label": "tree"
          },
          {
            "value": "login-01",
            "label": "login-01 (Block, página)"
          },
          {
            "value": "login-02",
            "label": "login-02 (Block, página)"
          },
          {
            "value": "otp-01",
            "label": "otp-01 (Block, página)"
          },
          {
            "value": "pricing-01",
            "label": "pricing-01 (Block, sección)"
          },
          {
            "value": "settings-01",
            "label": "settings-01 (Block, página)"
          },
          {
            "value": "signup-01",
            "label": "signup-01 (Block, página)"
          }
        ]
      }
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Reemplaza los archivos que ya existan con otro contenido."
    },
    "name": {
      "type": "string",
      "description": "Nombre de la página que genera un Block de tipo página (por defecto, el del Block sin el número: login-01 → login). En kebab-case: --name admin-login."
    }
  }
}
