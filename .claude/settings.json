      "Bash(git log *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git push origin auto/*)",
      "Bash(git push -u origin auto/*)",
      "Bash(git push origin config/*)",
